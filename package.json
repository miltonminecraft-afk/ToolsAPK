{
  "name": "toolsapk",
  "version": "1.0.0",
  "description": "Hybride Nederlandse Tools-app voor Android en GitHub Pages",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "sync:android": "cap sync android && node scripts/verify-android-assets.cjs",
    "android": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "pretest": "node scripts/vendor.cjs",
    "prebuild": "node scripts/vendor.cjs",
    "presync:android": "node scripts/vendor.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1"
  }
}
